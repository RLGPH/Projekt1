{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Projekt1: default",
            "type": "mplab-core-da",
            "request": "launch",
            "project": "Projekt1",
            "configuration": "default",
            "stopOnEntry": true,
            "preLaunchTask": "Projekt1: default - Build",
            "program": "${workspaceFolder}/out/Projekt1/default.elf"
        },
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "enter program name, for example ${workspaceFolder}/a.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}